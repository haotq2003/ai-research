# ==============================================================================
# AI RESEARCH INVESTIGATOR - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. API Keys (Bắt buộc)
GEMINI_API_KEY=your_gemini_api_key_here
SEARCHAPI_API_KEY=your_searchapi_key_here

# 2. Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=ai_research_db
DATABASE_URL=postgresql://postgres:mysecretpassword@postgres:5432/ai_research_db

# 3. Redis (BullMQ Queue & Pub/Sub)
REDIS_HOST=redis
REDIS_PORT=6379

# 4. Authentication (JWT)
JWT_SECRET=ai_research_super_secret_jwt_key_2026

# 5. App Ports
BACKEND_PORT=3000
FRONTEND_PORT=80
